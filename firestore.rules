rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Top-level users collection
    match /users/{uid} {
      allow read: if isOwner(uid);

      // Allow user creation if client initializes defaults, but prevent setting premium/extra scans
      // A new document starts with no scans: the server grants a guest's scans
      // and a real account's free scans once per device (claimGuestScans /
      // finalizeAccountUpgrade). Clients can not give themselves any.
      allow create: if isOwner(uid)
                    && (!request.resource.data.keys().hasAny(['isPremium', 'scansRemaining'])
                        || (request.resource.data.isPremium == false
                            && request.resource.data.scansRemaining <= 0));

      // Client can update name, email, avatar, etc., but CANNOT modify isPremium or scansRemaining
      allow update: if isOwner(uid)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'scansRemaining']);

      // Clients never delete their own user document: deleting it and
      // re-creating it (create allows up to 5 scans) would reset scan
      // credits. Account deletion goes through the deleteAccount function,
      // which uses the Admin SDK and is not subject to these rules.
      allow delete: if false;

      // Reports subcollection
      match /reports/{reportId} {
        allow read, write: if isOwner(uid);
      }

      // Collection (vault) subcollection
      match /collection/{itemId} {
        allow read, write: if isOwner(uid);
      }

      // Custom categories subcollection
      match /categories/{categoryId} {
        allow read, write: if isOwner(uid);
      }

      // App feedback - submit-only (no update/delete) so feedback can't be
      // tampered with after it's sent.
      match /feedback/{feedbackId} {
        allow read, create: if isOwner(uid);
      }
    }

    // Server-only collections (Admin SDK in Cloud Functions). No client
    // access: rate-limit counters and scan sessions used for billing.
    match /rate_limits/{doc} { allow read, write: if false; }
    match /scan_sessions/{doc} { allow read, write: if false; }
    match /device_grants/{doc} { allow read, write: if false; }
  }
}
